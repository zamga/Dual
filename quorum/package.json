{
  "name": "quorum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quorum: conviction-gated stock research. Four model families, a public sealed ledger, SMS only when the models agree.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"tests/**/*.test.js\"",
    "test:e2e": "node scripts/e2e.js",
    "engine:run": "node engine/cli.js run",
    "engine:export": "node engine/cli.js export",
    "build:web": "node scripts/build-web.js",
    "fixture": "node scripts/fixture-data.js",
    "check:sms": "node scripts/check-sms-templates.js",
    "server": "node server/index.js",
    "demo:day": "node scripts/demo-day.js",
    "test:core": "node --test \"tests/core/**/*.test.js\"",
    "test:engine": "node --test \"tests/engine/**/*.test.js\"",
    "test:server": "node --test \"tests/server/**/*.test.js\"",
    "test:web": "node --test \"tests/web/**/*.test.js\"",
    "test:e2e:member": "node tests/e2e/member-run.js",
    "engine:report": "node engine/tools/model-report.js",
    "scheduler:slots": "node server/scheduler.js",
    "build:artifact": "node scripts/build-artifact.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "zod": "^4.6.5"
  }
}
